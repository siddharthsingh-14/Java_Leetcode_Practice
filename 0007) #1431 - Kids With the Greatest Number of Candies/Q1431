class Solution1431 {
    public List<Boolean> kidsWithCandies(int[] candies, int extraCandies) {   int maxcandy = candies[0];
        for(int i =0; i<candies.length;i++){
            if(candies[i]>maxcandy){
                maxcandy = candies[i];
            }
        }
        List<Boolean> list = new ArrayList<>();
        for(int i =0; i<candies.length;i++){
            int newtotalcandy = candies[i]+extraCandies;
            if(newtotalcandy >= maxcandy){
                list.add(true);
            }
            else{
                list.add(false);
            }

        }
        return list;
    }
}